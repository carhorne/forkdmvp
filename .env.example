# Copy to .env.local and populate privately. These placeholders are not credentials.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
APP_URL=http://localhost:3000
SEED_TARGET=development

# Optional LOCAL ADMINISTRATIVE SEED TOOL ONLY. Leave unset for normal app use.
# Never put this in client code, NEXT_PUBLIC variables, or normal Vercel runtime.
# SUPABASE_SECRET_KEY=YOUR_PRIVATE_ADMIN_KEY
